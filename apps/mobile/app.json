{
  "expo": {
    "name": "mobile",
    "slug": "smb-commerce-os",
    "owner": "hbarraless-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "os.smbcommerce.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "os.smbcommerce.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Staff use the camera to photograph an item's condition at rental checkout and check-in. Photos are attached to the order's condition report only."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a664e467-49e9-413b-813a-797c885ad495"
      }
    }
  }
}
