{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "credentialsSource": "remote" },
      "android": { "credentialsSource": "remote" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "credentialsSource": "remote", "simulator": false },
      "android": { "credentialsSource": "remote", "buildType": "apk" },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": { "credentialsSource": "remote" },
      "android": { "credentialsSource": "remote" },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$EXPO_APPLE_ID",
        "ascAppId": "$EXPO_ASC_APP_ID",
        "appleTeamId": "$EXPO_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "$EXPO_GOOGLE_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal"
      }
    }
  }
}
